@model LibraryManagerMVC_2212447.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h2>Xóa danh mục</h2>

<h3>Bạn có chắc chắn muốn xóa danh mục này?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            Số lượng sách
        </dt>
        <dd class="col-sm-10">
            @Model.Books.Count sách
        </dd>
    </dl>

    @if (Model.Books.Any())
    {
        <div class="alert alert-warning">
            <strong>Cảnh báo:</strong> Danh mục này còn có @Model.Books.Count sách. Không thể xóa danh mục khi còn sách.
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="CategoryId" />
            <input type="submit" value="Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    }
</div>